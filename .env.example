# Copia este archivo a .env (local) y carga las mismas variables en Vercel
# (Project Settings → Environment Variables). Nunca subas el .env real a git.

# ── WhatsApp Cloud API (Meta for Developers) ──────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Tu número personal (con código de país, sin '+', ej. 524791234567) — ahí
# te llegan los avisos de pedidos nuevos y de conversaciones escaladas.
OWNER_PHONE=

# ── Claude ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Supabase (server-side, NUNCA exponer la service role key al navegador) ─
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase (cliente del navegador, para /admin/pedidos — la llave anon SÍ
# es pública/segura de exponer, la protección real es RLS) ─────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
